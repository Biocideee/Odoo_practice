<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_order_form_plugit">
        <field name="name">sale.order.form.plugit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="domain">[("parent_id", "=", partner_id)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="domain">[("parent_id", "=", partner_id)]</attribute>
                <attribute name="options"></attribute>
                <attribute name="context">{'default_name': partner_id.name + ', Адреса доставки', 'default_type':'delivery', 'show_address': False, 'show_vat': False, 'default_parent_id': partner_id}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <label for="full_delivery_address" />
                <div>
                    <field name="full_delivery_address" readonly="1" />
                </div>
            </xpath>

        </field>
    </record>
</odoo>
