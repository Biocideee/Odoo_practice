<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_warehouse_plugit">
        <field name="name">stock.warehouse.form.plugit</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse" />
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="attributes">
                <attribute name="groups" />
            </xpath>
            <xpath expr="//notebook/page[@name='warehouse_config']" position="attributes">
                <attribute name="groups">stock.group_adv_location,stock.group_stock_multi_warehouses</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='technical_info']" position="attributes">
                <attribute name="groups">stock.group_adv_location,stock.group_stock_multi_warehouses</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='warehouse_config']" position="before">
                <page name="addresses" string="Адреси провайдерів">
                    <field name="partner_ids" context="{'default_type': 'delivery', 'default_parent_id': company_partner_id}" domain="[('parent_id', '=', company_partner_id), ('type', '=', 'delivery')]">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="carrier_type" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
