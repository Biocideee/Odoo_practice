<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="np_settlement_view_list" model="ir.ui.view">
        <field name="model">plugit.np_settlement</field>
        <field name="arch" type="xml">
            <list string="Населені пункти">
                <field name="full_name"  />
                <field name="name" optional="hide" />
                <field name="name_ru" optional="hide" />
                <field name="area_id" optional="hide" />
                <field name="region_id" optional="hide" />
                <field name="settlement_type_id" optional="hide" />
                <field name="ref" optional="hide" />
            </list>
        </field>
    </record>

    <record id="np_settlements_action" model="ir.actions.act_window">
        <field name="name">Населені пункти</field>
        <field name="res_model">plugit.np_settlement</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
