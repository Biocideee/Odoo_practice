<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form_plugit_novaposhta" model="ir.ui.view">
        <field name="name">res.partner.form.plugit.novaposhta</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority">1001</field>
        <field name="arch" type="xml">

            <!-- Change address fields for main form for "novaposhta" carrier type -->
            <xpath expr="//group[./div[hasclass('o_address_format')]]" position="replace">
                <group>
                    <span class="o_form_label o_td_label o_address_type" name="address_name">
                        <field
                            name="type"
                            invisible="is_company"
                            readonly="user_ids"
                            required="not is_company"
                            class="fw-bold"
                        />
                        <span invisible="not is_company">Address</span>
                    </span>

                    <div class="o_address_format">
                        <field name="carrier_id" options="{'no_open': True}" invisible="type != 'delivery'" />
                        <field name="carrier_type" invisible="1" />
                        <field
                            name="street"
                            placeholder="Street..."
                            class="o_address_street"
                            readonly="type == 'contact' and parent_id"
                            invisible="carrier_type == 'novaposhta' and type == 'delivery'"
                        />
                        <field
                            name="street2"
                            placeholder="Street 2..."
                            class="o_address_street"
                            readonly="type == 'contact' and parent_id"
                            invisible="carrier_type == 'novaposhta' and type == 'delivery'"
                        />
                        <field
                            name="city"
                            placeholder="City"
                            class="o_address_city"
                            readonly="type == 'contact' and parent_id"
                            invisible="carrier_type == 'novaposhta' and type == 'delivery'"
                        />
                        <field
                            name="state_id"
                            class="o_address_state"
                            placeholder="State"
                            options="{'no_open': True, 'no_quick_create': True}"
                            readonly="type == 'contact' and parent_id"
                            context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"
                            invisible="carrier_type == 'novaposhta' and type == 'delivery'"
                        />
                        <field
                            name="zip"
                            placeholder="ZIP"
                            class="o_address_zip"
                            readonly="type == 'contact' and parent_id"
                            invisible="carrier_type == 'novaposhta' and type == 'delivery'"
                        />
                        <div name="partner_address_country" class="d-flex justify-content-between">
                            <field
                                name="country_id"
                                placeholder="Country"
                                class="o_address_country"
                                options='{"no_open": True, "no_create": True}'
                                readonly="type == 'contact' and parent_id"
                                invisible="carrier_type == 'novaposhta' and type == 'delivery'"
                            />
                        </div>
                    </div>

                    <field name="vat" placeholder="e.g. BE0477472701" readonly="parent_id" invisible="type == 'delivery'" />
                    <field name="np_address_ref" invisible="1" />

                    <field
                        name="np_settlement_id"
                        widget="many2one"
                        options="{'no_create': True, 'no_open': True}"
                        readonly="np_address_ref"
                        required="carrier_type == 'novaposhta'"
                        invisible="carrier_type != 'novaposhta' or type != 'delivery'"
                    />
                    <field
                        name="np_target_type"
                        readonly="np_address_ref"
                        required="carrier_type == 'novaposhta'"
                        invisible="carrier_type != 'novaposhta' or type != 'delivery'"
                    />
                    <field
                        name="np_warehouse_id"
                        string="Склад"
                        invisible="np_target_type != 'warehouse' or carrier_type != 'novaposhta' or type != 'delivery'"
                        required="np_target_type == 'warehouse'"
                        readonly="np_address_ref"
                        widget="many2one"
                        options="{'no_create': True, 'no_open': True}"
                        domain="[('settlement_id', '=', np_settlement_id), ('np_target_type', '=', np_target_type)]"
                    />
                    <field
                        name="np_warehouse_id"
                        string="Поштомат"
                        invisible="np_target_type != 'poshtomat' or carrier_type != 'novaposhta' or type != 'delivery'"
                        required="np_target_type == 'poshtomat'"
                        readonly="np_address_ref"
                        widget="many2one"
                        options="{'no_create': True, 'no_open': True}"
                        domain="[('settlement_id', '=', np_settlement_id), ('np_target_type', '=', np_target_type)]"
                    />
                    <field
                        name="np_street_id"
                        placeholder="Вулиця"
                        invisible="np_target_type != 'courier' or carrier_type != 'novaposhta' or type != 'delivery'"
                        required="np_target_type == 'courier'"
                        readonly="np_address_ref"
                        domain="[('np_settlement_id', '=', np_settlement_id)]"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field
                        name="house_number"
                        placeholder="Номер будинку"
                        readonly="np_address_ref"
                        class="o_address_city"
                        invisible="np_target_type != 'courier' or carrier_type != 'novaposhta' or type != 'delivery'"
                        required="np_target_type == 'courier'"
                    />
                    <field
                        name="apart_number"
                        placeholder="Номер квартири"
                        class="o_address_city"
                        invisible="np_target_type != 'courier' or carrier_type != 'novaposhta' or type != 'delivery'"
                        readonly="np_address_ref"
                    />
                </group>
            </xpath>

            <xpath expr="//field[@name='contact_person_name']" position="after">
                <field name="contact_middle_name" required="carrier_type == 'novaposhta' and np_target_type == 'courier'" />
            </xpath>
            <xpath expr="//field[@name='contact_person_name']" position="attributes">
                <attribute name="required">carrier_type == 'novaposhta'</attribute>
            </xpath>
            <xpath expr="//field[@name='contact_person_surname']" position="attributes">
                <attribute name="required">carrier_type == 'novaposhta'</attribute>
            </xpath>

            <xpath expr="//form//form/sheet//div[@name='div_address']" position="attributes">
                <attribute name="invisible">carrier_type == 'novaposhta'</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet/group[@name='other_info']/group/span[hasclass('o_address_type')]" position="attributes">
                <attribute name="invisible">carrier_type == 'novaposhta'</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//field[@name='email' and not(ancestor::group[@name='np_contact_details'])]" position="attributes">
                <attribute name="invisible">carrier_type == 'novaposhta'</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//field[@name='phone' and not(ancestor::group[@name='np_contact_details'])]" position="attributes">
                <attribute name="invisible">carrier_type == 'novaposhta'</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//field[@name='contact_person_name' and not(ancestor::group[@name='np_contact_details'])]" position="attributes">
                <attribute name="invisible">carrier_type == 'novaposhta'</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//field[@name='contact_person_surname' and not(ancestor::group[@name='np_contact_details'])]" position="attributes">
                <attribute name="invisible">carrier_type == 'novaposhta'</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//field[@name='name' and not(ancestor::group[@name='np_contact_details'])]" position="attributes">
                <attribute name="invisible">carrier_type == 'novaposhta'</attribute>
            </xpath>
            <xpath expr="//field[@name='company_type']" position="attributes">
                <attribute name="invisible">type != 'contact'</attribute>
            </xpath>

            <xpath expr="//page//form/sheet//field[@name='carrier_id']" position="after">
                <field name="np_address_ref" invisible="1" />
                <div invisible="carrier_type != 'novaposhta'">
                    <group>
                        <field name="np_target_type" />
                        <field
                            name="np_settlement_id"
                            widget="many2one"
                            options="{'no_create': True, 'no_open': True}"
                            required="carrier_type == 'novaposhta'"
                            readonly="np_address_ref"
                        />
                        <field
                            name="np_warehouse_id"
                            string="Склад"
                            invisible="np_target_type != 'warehouse'"
                            required="np_target_type == 'warehouse'"
                            readonly="np_address_ref"
                            widget="many2one"
                            options="{'no_create': True, 'no_open': True}"
                            domain="[('settlement_id', '=', np_settlement_id), ('np_target_type', '=', np_target_type)]"
                        />
                        <field
                            name="np_warehouse_id"
                            string="Поштомат"
                            invisible="np_target_type != 'poshtomat'"
                            required="np_target_type == 'poshtomat'"
                            readonly="np_address_ref"
                            widget="many2one"
                            options="{'no_create': True, 'no_open': True}"
                            domain="[('settlement_id', '=', np_settlement_id), ('np_target_type', '=', np_target_type)]"
                        />
                    </group>

                    <strong>
                        <label for="np_street_id" string="Адреса" invisible="np_target_type not in ('courier',)" />
                    </strong>
                    <div invisible="np_target_type not in ('courier',)">
                        <div class="o_address_format" name="address_novaposhta">
                            <field
                                name="np_street_id"
                                placeholder="Вулиця"
                                invisible="np_target_type != 'courier'"
                                readonly="np_address_ref"
                                required="np_target_type in ('courier',)"
                                domain="[('np_settlement_id', '=', np_settlement_id)]"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field
                                name="house_number"
                                placeholder="Номер будинку"
                                class="o_address_city"
                                readonly="np_address_ref"
                                required="np_target_type in ('courier',)"
                            />
                            <field
                                name="apart_number"
                                placeholder="Номер квартири"
                                class="o_address_city"
                                readonly="np_address_ref"
                            />
                        </div>
                    </div>

                    <group name="np_contact_details" string="Контактні дані">
                        <field name="phone" string="Телефон" widget="phone" required="1" readonly="np_address_ref" />
                        <field name="contact_person_name" string="Ім'я" required="1" readonly="np_address_ref" />
                        <field name="contact_middle_name" string="По-батькові" required="np_target_type == 'courier'" readonly="np_address_ref" />
                        <field name="contact_person_surname" string="Прізвище" required="1" readonly="np_address_ref" />
                        <field name="name" string="Адреса доставки" readonly="1" />
                    </group>
                </div>
            </xpath>

            <xpath expr="//notebook/page[@name='contact_addresses']//form//field[@name='type']" position="attributes">
                <attribute name="readonly">np_address_ref</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='contact_addresses']//form//field[@name='carrier_id']" position="attributes">
                <attribute name="readonly">np_address_ref</attribute>
            </xpath>

        </field>
    </record>
</odoo>
