<?xml version='1.0' encoding='utf-8' ?>
<odoo>
  <record id="view_delivery_carrier_form_inherit_delivery_novaposhta" model="ir.ui.view">
    <field name="name">delivery.carrier.form.inherit.delivery.novaposhta</field>
    <field name="model">delivery.carrier</field>
    <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='integration_level']" position="before">
        <field name="novaposhta_production_api_key" invisible="delivery_type != 'novaposhta'" password="True" />
      </xpath>
      <xpath expr="//field[@name='integration_level']" position="after">
        <field name="novaposhta_payment_type" widget="radio" invisible="delivery_type != 'novaposhta'" options="{'horizontal': true}"/>
        <field name="novaposhta_payment_side" widget="radio" invisible="delivery_type != 'novaposhta'" options="{'horizontal': true}"/>
      </xpath>
    </field>
  </record>
</odoo>
