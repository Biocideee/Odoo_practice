<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- ФОРМА -->

    <record id="view_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.form</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <sheet>
                    <div class="d-flex mb-4">
                        <div class="me-4">
                            <field name="image" widget="image" class="oe_avatar" options="{'size': [128, 128]}"/>
                        </div>

                        <div class="oe_title w-100">
                            <h1>
                                <field name="last_name" placeholder="Last Name" class="me-2"/>
                                <field name="first_name" placeholder="First Name" class="me-2"/>
                                <field name="middle_name" placeholder="Middle Name"/>
                            </h1>

                            <div class="text-muted fs-5 mt-2">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa fa-phone fa-fw me-2" title="Phone"/>
                                    <field name="phone_number" placeholder="Phone Number"/>
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa fa-envelope fa-fw me-2" title="Email"/>
                                    <field name="email" placeholder="Email Address"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Professional Information">
                            <field name="specialty_id"/>
                            <field name="license_number"/>
                        </group>
                        <group string="Mentorship Status">
                            <field name="is_intern"/>
                            <field name="doctor_mentor_id" invisible="is_intern == False"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Interns" invisible="is_intern == True">
                            <field name="intern_ids" mode="kanban" context="{'default_is_intern': True}">
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <div class="p-2">
                                                <strong class="fs-5 d-block mb-1">
                                                    <i class="fa fa-user-md me-2"/>
                                                    <field name="last_name"/> <field name="first_name"/>
                                                </strong>
                                                <div class="text-muted">
                                                    <field name="specialty_id"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ПОШУК -->

    <record id="view_doctor_search" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.search</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <search string="Search Doctors">
                <field name="full_name"/>
                <field name="specialty_id"/>
                <filter string="Interns" name="filter_interns" domain="[('is_intern', '=', True)]"/>
                <filter string="Mentors" name="filter_mentors" domain="[('intern_ids', '!=', False)]"/>

                <group>
                    <filter string="Specialty" name="group_by_specialty" context="{'group_by' : 'specialty_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ДІЯ -->

    <record id="action_doctors" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hr_hospital.doctor</field>
        <field name="view_mode">list,form,search</field>
    </record>
</odoo>