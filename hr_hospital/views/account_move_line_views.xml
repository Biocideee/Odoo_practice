<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Account Move Line Form View -->
        <record id="view_move_line_form_inherit" model="ir.ui.view">
            <field name="name">account.move.line.form.inherit</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price_unit']" position="attributes">
                    <attribute name="attrs">{'readonly': [('is_storno', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='price_subtotal']" position="attributes">
                    <attribute name="attrs">{'readonly': [('is_storno', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='price_total']" position="attributes">
                    <attribute name="attrs">{'readonly': [('is_storno', '=', True)]}</attribute>
                </xpath>
            </field>
        </record>

        <!-- Account Move Line Tree View -->
        <record id="view_move_line_tree_inherit" model="ir.ui.view">
            <field name="name">account.move.line.tree.inherit</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price_unit']" position="attributes">
                    <attribute name="attrs">{'readonly': [('is_storno', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='price_subtotal']" position="attributes">
                    <attribute name="attrs">{'readonly': [('is_storno', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='price_total']" position="attributes">
                    <attribute name="attrs">{'readonly': [('is_storno', '=', True)]}</attribute>
                </xpath>
            </field>
        </record>

        <!-- Add is_storno field to views -->
        <record id="view_move_line_form_storno" model="ir.ui.view">
            <field name="name">account.move.line.form.storno</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price_unit']" position="before">
                    <field name="is_storno" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_move_line_tree_storno" model="ir.ui.view">
            <field name="name">account.move.line.tree.storno</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="after">
                    <field name="is_storno" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
