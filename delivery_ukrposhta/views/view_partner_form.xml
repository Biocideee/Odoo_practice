<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="carrier_view_partner_form_inherit_ukrposhta" model="ir.ui.view">
        <field name="name">carrier.res.partner.form.inherit.ukrposhta</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">1100</field>
        <field name="arch" type="xml">
            <!--
                ============================================================
                ЗОВНІШНЯ ФОРМА (повна форма партнера)
                ============================================================
            -->

            <!-- Район у головному адресному блоці після City -->
            <xpath expr="//field[@name='city']" position="after">
                <field name="ukrposhta_district"
                       placeholder="Район"
                       invisible="type != 'delivery' or carrier_type != 'ukrposhta'"/>
            </xpath>

            <!--
                plugit_delivery_base додає у головну форму окрему групу справа
                з полями phone, contact_person_name, contact_person_surname,
                category_id (visible only when type='delivery'). Вставляємо
                carrier_id перед contact_person_name — щоб поле опинилось
                у тій же групі, а не в заголовку з phone-іконкою.
            -->
            <xpath expr="//field[@name='contact_person_name']" position="before">
                <field name="carrier_id"
                       string="Спосіб доставки"
                       options="{'no_open': True}"
                       invisible="type != 'delivery'"/>
            </xpath>

            <!-- По-батькові після прізвища (у головній групі delivery-контакта) -->
            <xpath expr="//field[@name='contact_person_surname']" position="after">
                <field name="contact_middle_name"
                       string="По-батькові"
                       invisible="type != 'delivery'"/>
            </xpath>

            <!-- Будинок/Квартира — частина адреси, після Району -->
            <xpath expr="//field[@name='ukrposhta_district']" position="after">
                <field name="house_number"
                       placeholder="Будинок"
                       invisible="type != 'delivery'"/>
                <field name="apart_number"
                       placeholder="Квартира"
                       invisible="type != 'delivery'"/>
            </xpath>

            <!--
                ============================================================
                ВНУТРІШНЯ ФОРМА (popup "Відкрити: Контакт")
                ============================================================
                Popup-форма embed-нута всередині батьківської як inner <form>
                всередині <field name="child_ids">. Xpath '//form//form/sheet//'
                цілить ТІЛЬКИ цю inner-форму, бо першу зовнішню вже не зачіпає.

                ВАЖЛИВО: carrier_id у popup-і вже додається `plugit_delivery_base`
                (xpath: //notebook/page[@name='contact_addresses']//form/sheet//
                 field[@name='name'] position="before"). Не дублюємо.

                Ми додаємо тільки:
                  * contact_middle_name (по-батькові) — після прізвища
                  * placeholder на існуючі firstname/surname/middle_name,
                    щоб порожні поля не зливались з фоном popup'а
            -->
            <xpath expr="//form//form/sheet//field[@name='contact_person_surname']" position="after">
                <field name="contact_middle_name"
                       string="По-батькові"
                       placeholder="По-батькові"
                       invisible="type != 'delivery'"/>
            </xpath>

            <!--
                Додаємо placeholder'и до полів, які plugit_delivery_base ставить
                в popup без них. Без placeholder'а порожнє поле виглядає
                як пустий простір білого кольору — користувач не розуміє,
                куди клікнути.
            -->
            <xpath expr="//form//form/sheet//field[@name='contact_person_name']" position="attributes">
                <attribute name="placeholder">Ім'я</attribute>
            </xpath>
            <xpath expr="//form//form/sheet//field[@name='contact_person_surname']" position="attributes">
                <attribute name="placeholder">Прізвище</attribute>
            </xpath>
        </field>
    </record>
</odoo>
