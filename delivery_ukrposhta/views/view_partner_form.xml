<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="carrier_view_partner_form_inherit_ukrposhta" model="ir.ui.view">
        <field name="name">carrier.res.partner.form.inherit.ukrposhta</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">1100</field>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='city']" position="after">
                <field name="ukrposhta_district"
                       placeholder="Район (опціонально)"
                       invisible="type != 'delivery' or carrier_type != 'ukrposhta'"/>
            </xpath>

            <xpath expr="//field[@name='ukrposhta_district']" position="after">
                <field name="house_number"
                       placeholder="Будинок"
                       class="o_address_city"
                       invisible="type != 'delivery' or carrier_type != 'ukrposhta'"/>
                <field name="apart_number"
                       placeholder="Квартира"
                       class="o_address_city"
                       invisible="type != 'delivery' or carrier_type != 'ukrposhta'"/>
            </xpath>

            <!-- Приховування полів у внутрішній формі -->
            <xpath expr="//form//form/sheet//div[@name='div_address']" position="attributes">
                <attribute name="invisible" separator="or" add="carrier_type == 'ukrposhta'"/>
            </xpath>

            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet/group[@name='other_info']/group/span[hasclass('o_address_type')]"
                   position="attributes">
                <attribute name="invisible" separator="or" add="carrier_type == 'ukrposhta'"/>
            </xpath>

            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//field[@name='email' and not(ancestor::group[@name='np_contact_details'])]"
                   position="attributes">
                <attribute name="invisible" separator="or" add="carrier_type == 'ukrposhta'"/>
            </xpath>

            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//field[@name='phone' and not(ancestor::group[@name='np_contact_details'])]"
                   position="attributes">
                <attribute name="invisible" separator="or" add="carrier_type == 'ukrposhta'"/>
            </xpath>

            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//field[@name='contact_person_name' and not(ancestor::group[@name='np_contact_details'])]"
                   position="attributes">
                <attribute name="invisible" separator="or" add="carrier_type == 'ukrposhta'"/>
            </xpath>

            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//field[@name='contact_person_surname' and not(ancestor::group[@name='np_contact_details'])]"
                   position="attributes">
                <attribute name="invisible" separator="or" add="carrier_type == 'ukrposhta'"/>
            </xpath>

            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//field[@name='name' and not(ancestor::group)]"
                   position="attributes">
                <attribute name="invisible" separator="or" add="carrier_type == 'ukrposhta'"/>
            </xpath>

            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//*[hasclass('fa-envelope')]"
                   position="attributes">
                <attribute name="invisible" separator="or" add="carrier_type == 'ukrposhta'"/>
            </xpath>

            <xpath expr="//notebook/page[@name='contact_addresses']//form/sheet//*[hasclass('fa-phone')]"
                   position="attributes">
                <attribute name="invisible" separator="or" add="carrier_type == 'ukrposhta'"/>
            </xpath>

            <xpath expr="//form//form/sheet//field[@name='carrier_id']" position="after">

                <div invisible="carrier_type != 'ukrposhta' or type != 'delivery'">

                    <group string="Контактні дані">
                        <group>
                            <field name="zip" string="Поштовий індекс"/>
                            <field name="state_id" string="Область" options="{'no_open': True, 'no_create': True}"/>
                            <field name="ukrposhta_district" string="Район"/>
                            <field name="city" string="Місто / Н.П."/>
                        </group>

                        <group>
                            <field name="street" string="Вулиця"/>
                            <field name="house_number" string="Буд."/>
                            <field name="apart_number" string="Кв."/>
                            <field name="phone" string="Телефон" widget="phone"/>
                        </group>

                        <group>
                            <field name="contact_person_surname" string="Прізвище"/>
                            <field name="contact_person_name" string="Ім'я"/>
                            <field name="contact_middle_name" string="По-батькові"/>
                        </group>

                    </group>

                    <group invisible="carrier_type != 'ukrposhta'">
                        <field name="name" string="Адреса доставки" readonly="1"/>
                    </group>
                </div>
            </xpath>

        </field>
    </record>
</odoo>