<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_delivery_carrier_form_inherit_delivery_ukrposhta" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.delivery.ukrposhta</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='integration_level']" position="before">
                <field name="ukrposhta_test_api_key"
                       invisible="delivery_type != 'ukrposhta'"
                       password="True"/>
                <field name="ukrposhta_production_api_key"
                       invisible="delivery_type != 'ukrposhta'"
                       password="True"/>
                <field name="ukrposhta_test_token"
                       invisible="delivery_type != 'ukrposhta'"
                       password="True"/>
                <field name="ukrposhta_production_token"
                       invisible="delivery_type != 'ukrposhta'"
                       password="True"/>
            </xpath>
        </field>
    </record>
</odoo>
