<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_quotation_sale_form_inherit_ukrposhta" model="ir.ui.view">
        <field name="name">quotation.sale.form.inherit.ukrposhta</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">1100</field>
        <field name="arch" type="xml">
            <!--
                Інформаційне поле повної адреси доставки — readonly,
                для зручності бачити куди їде відправлення на формі quotation.
                В Odoo 19 payment_term_id — стабільний якір на верхньому рівні форми.
            -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <label for="full_delivery_address" string="Адреса доставки"/>
                <div>
                    <field name="full_delivery_address" class="oe_inline" readonly="1" force_save="1"/>
                </div>
            </xpath>

            <!--
                Editable carrier_id у Other Info → DELIVERY секції.
                Стандартна поведінка Odoo: при виборі carrier'а він автоматично
                підставляється на picking при підтвердженні замовлення.
            -->
            <xpath expr="//field[@name='warehouse_id']" position="after">
                <field name="carrier_id"
                       options="{'no_create': True, 'no_open': False}"/>
            </xpath>
        </field>
    </record>
</odoo>
